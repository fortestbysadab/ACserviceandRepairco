# ---------------------------------------------------------------------------
# Local development: copy to .env and run `node --env-file=.env scripts/migrate.mjs`
# Production: set these in the Render dashboard (never commit a real .env)
# ---------------------------------------------------------------------------

NODE_ENV=development

# Neon, region ap-southeast-1 (Singapore). Pooled host contains "-pooler".
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/sheetal?sslmode=require"
# Same database, unpooled host — used only by the migration runner.
DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/sheetal?sslmode=require"

# openssl rand -base64 48
SESSION_SECRET="replace-with-48-random-bytes"
# openssl rand -hex 24
CRON_SECRET="replace-with-24-random-bytes"

# Public origin of the static marketing site
APP_ORIGIN="https://www.example.in"
# Shared cookie domain so www + app are same-site
COOKIE_DOMAIN=".example.in"

# ---- provision later; the scaffold boots without them ----
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
